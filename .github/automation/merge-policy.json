{
  "schema_version": 1,
  "default_branch": "master",
  "accepted_required_conclusions": ["success"],
  "maximum_ci_wait_minutes": 180,
  "maximum_repair_commits": 3,
  "required": [
    {"name": "automation/classification", "app_slug": "github-actions"},
    {"name": "lint", "app_slug": "github-actions"},
    {"name": "pre-commit", "app_slug": "github-actions"}
  ],
  "required_patterns": [
    {"pattern": "^build \\(.*\\)$", "app_slug": "github-actions"}
  ],
  "category_required": {
    "docs": [
      {"name": "Build documentation", "app_slug": "github-actions"},
      {"name": "Check internal documentation links", "app_slug": "github-actions"}
    ]
  },
  "advisory": [
    {"name": "Check external documentation links", "app_slug": "github-actions"},
    {"name": "pre-commit-autofix", "app_slug": "github-actions"}
  ],
  "ignored_automation_checks": [
    "codex/autofix",
    "enable-automerge"
  ],
  "fork_rules": {
    "inapplicable": ["^Build and push Docker image \\(PR\\)$"],
    "repair_push_allowed": false
  }
}
