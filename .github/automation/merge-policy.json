{
  "accepted_required_conclusions": [
    "success"
  ],
  "advisory": [
    {
      "app_slug": "github-actions",
      "name": "Check external documentation links"
    },
    {
      "app_slug": "github-actions",
      "name": "pre-commit-autofix"
    }
  ],
  "category_required": {
    "docs": [
      {
        "app_slug": "github-actions",
        "name": "Build documentation"
      },
      {
        "app_slug": "github-actions",
        "name": "Check internal documentation links"
      }
    ]
  },
  "default_branch": "master",
  "fork_rules": {
    "inapplicable": [
