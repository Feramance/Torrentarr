    "repair_push_allowed": false
  },
  "ignored_automation_checks": [
    "codex/autofix",
    "enable-automerge"
  ],
  "maximum_ci_wait_minutes": 180,
  "maximum_repair_commits": 3,
  "required": [
    {
      "app_slug": "github-actions",
      "name": "automation/classification"
    },
    {
      "app_slug": "github-actions",
      "name": "lint"
    },
    {
      "app_slug": "github-actions",
      "name": "pre-commit"
    }
  ],
  "required_patterns": [
    {
      "app_slug": "github-actions",
      "pattern": "^build \\(.*\\)$"
    },
    {
      "app_slug": "github-actions",
      "pattern": "^Build and push Docker image \\(PR\\)$"
    },
    {
      "app_slug": "github-actions",
      "pattern": "^Analyze \\(.*\\)$"
    }
  ],
  "schema_version": 1
